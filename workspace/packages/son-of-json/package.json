{
  "main": "./out/node/jsonClientMain.js",
  "name": "son-of-json",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "publisher": "DRKV",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.77.0"
  },
  "icon": "icons/json.png",
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:snippets",
    "onCommand:jsonson.validate"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%jsonson.workspaceTrust%"
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "id": "jsonson",
      "order": 20,
      "type": "object",
      "title": "Son of JSON",
      "properties": {
        "jsonson.schemas": {
          "type": "array",
          "scope": "resource",
          "description": "%jsonson.schemas.desc%",
          "items": {
            "type": "object",
            "default": {
              "uri": "http://example.com/my-schema",
              "schemaFile": "schemas/my-schema.schema.json"
            },
            "properties": {
              "uri": {
                "type": "string",
                "markdownDescription": "%jsonson.schemas.uri.desc%"
              },
              "schemaFile": {
                "type": "string",
                "description": "%jsonson.schemas.schemaFile.desc%"
              },
              "retrievalUri": {
                "type": "string",
                "description": "%jsonson.schemas.retrievalUri.desc%"
              },
              "fileMatch": {
                "type": "array",
                "items": {
                  "type": "string",
                  "markdownDescription": "%jsonson.schemas.fileMatch.item.desc%"
                },
                "minItems": 1,
                "markdownDescription": "%jsonson.schemas.fileMatch.desc%"
              },
              "schema": {
                "$ref": "http://json-schema.org/draft-07/schema#",
                "description": "%jsonson.schemas.schema.desc%"
              }
            }
          }
        },
        "jsonson.validate.enable": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "%jsonson.validate.enable.desc%"
        },
        "jsonson.format.enable": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "%jsonson.format.enable.desc%"
        },
        "jsonson.format.keepLines": {
          "type": "boolean",
          "scope": "window",
          "default": false,
          "description": "%jsonson.format.keepLines.desc%"
        },
        "jsonson.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%jsonson.tracing.desc%"
        },
        "jsonson.colorDecorators.enable": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "%jsonson.colorDecorators.enable.desc%",
          "deprecationMessage": "%jsonson.colorDecorators.enable.deprecationMessage%"
        },
        "jsonson.maxItemsComputed": {
          "type": "number",
          "default": 5000,
          "description": "%jsonson.maxItemsComputed.desc%"
        },
        "jsonson.schemaDownload.enable": {
          "type": "boolean",
          "default": false,
          "description": "%jsonson.enableSchemaDownload.desc%",
          "tags": [
            "usesOnlineServices"
          ]
        },
        "jsonson.schemaDownload.trustedDomains": {
          "type": "object",
          "default": {
            "https://schemastore.azurewebsites.net/": true,
            "https://raw.githubusercontent.com/microsoft/vscode/": true,
            "https://raw.githubusercontent.com/devcontainers/spec/": true,
            "https://www.schemastore.org/": true,
            "https://json.schemastore.org/": true,
            "https://json-schema.org/": true,
            "https://developer.microsoft.com/json-schemas/": true
          },
          "additionalProperties": {
            "type": "boolean"
          },
          "markdownDescription": "%jsonson.schemaDownload.trustedDomains.desc%",
          "tags": [
            "usesOnlineServices"
          ]
        }
      }
    },
    "configurationDefaults": {
      "[json]": {
        "editor.quickSuggestions": {
          "strings": true
        },
        "editor.suggest.insertMode": "replace"
      },
      "[jsonc]": {
        "editor.quickSuggestions": {
          "strings": true
        },
        "editor.suggest.insertMode": "replace"
      },
      "[snippets]": {
        "editor.quickSuggestions": {
          "strings": true
        },
        "editor.suggest.insertMode": "replace"
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.schema.json",
        "url": "http://json-schema.org/draft-07/schema#"
      }
    ],
    "commands": [
      {
        "command": "jsonson.clearCache",
        "title": "%jsonson.command.clearCache%",
        "category": "Son of JSON"
      },
      {
        "command": "jsonson.sort",
        "title": "%jsonson.command.sort%",
        "category": "Son of JSON"
      }
    ]
  },
  "dependencies": {
    "request-light": "^0.8.0",
    "vscode-languageclient": "^10.0.0-next.22"
  },
  "devDependencies": {
    "@types/vscode": "^1.77.0",
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
