{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/packages/son-of-json"
			],
			"sourceMaps": true,
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Launch Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/son-of-json", "--extensionTestsPath=${workspaceFolder}/packages/son-of-json/out/test" ],
			"sourceMaps": true,
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Attach Language Server",
			"type": "node",
			"request": "attach",
			"port": 6004,
			"sourceMaps": true,
		}
	],
	"compounds": [
		{
			"name": "Launch Extension and Attach Language Server",
			"configurations": [
				"Launch Extension",
				"Attach Language Server"
			]
		}
	]
}
